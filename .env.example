# Copy this file to .env for local development. Keep real values private.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
COORDINATOR_PASSWORD=replace-with-a-unique-coordinator-password
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_SECRET=use-the-same-long-random-secret-as-Apps-Script-API_SECRET
COOKIE_SECURE=false
PORT=5000
